/*=============================================================================
	LUTBlender.usf: Filter pixel shader source.   

	This file shadows Engine/Shaders/Private/PostProcessCombineLUTs.usf.
	The TonemapOverride plugin injects custom tonemapping operators at the
	LUT baking stage (FilmToneMap call), so color grading works properly.

	Note: Any changes to device encoding logic in CombineLUTsCommon() must
	also be made in PostProcessDeviceEncodingOnly.usf.
=============================================================================*/

#define USE_COLOR_MATRIX	1
#define USE_SHADOW_TINT		1
#define USE_CONTRAST		1

#include "Common.ush"
#include "PostProcessCommon.ush"
#include "TonemapCommon.ush"

// Values:
//   0 = ACES Filmic (engine default FilmToneMap)
//   1 = AgX (Punchy)
//   2 = Reinhard
//   3 = Linear (no tonemapping)
//   4 = Custom (see CustomTonemapOperator below)
//   5 = Gran Turismo "GT Tonemap" (Uchimura 2017)
//   6 = Gran Turismo 7 (2025) physically-based / perceptual tonemap
//   7 = Apex (ShaderShift) — AgX chroma handling + GT display-peak tonescale
//   8 = Prism (ShaderShift) — hue-preserving luminance + fit-to-peak desat


#define CUSTOM_TONEMAP_MODE 1  // Change this to switch tonemappers


// 0: Default, 1: Golden, 2: Punchy

#define AGX_LOOK 2


// ── Gran Turismo "GT Tonemap" parameters [Uchimura 2017, "HDR theory and
// practice"] — desmos.com/calculator/gslcdxvipg.  Per-channel curve in
// linear sRGB: toe (pow) -> linear midsection -> exponential shoulder.
#define GT_PEAK              1.0   // P  max display value
#define GT_CONTRAST          1.0   // a  contrast / linear-section slope
#define GT_LINEAR_START      0.22  // m  where the linear section begins
#define GT_LINEAR_LENGTH     0.4   // l  length of the linear section
#define GT_TOE_CURVE         1.33  // c  black tightness (toe power)
#define GT_TOE_OFFSET        0.0   // b  pedestal / black offset

// ── HDR output handling ──────────────────────────────────────────────────────
// When a custom tonemapper (CUSTOM_TONEMAP_MODE != 0) is active AND the output
// device is an HDR mode (ACES ST2084 / scRGB), the engine would normally ignore
// the custom tonemap and run the ACES Output Transform on the un-tonemapped
// GradedColor.  With CUSTOM_HDR_PARITY enabled we instead route the custom
// tonemapper to the HDR signal:
//
//   * CUSTOM_HDR_NATIVE = 1 (default): GT (mode 5) and GT7 (mode 6) tone-map to
//     the display's actual peak luminance (OutputMaxLuminance) and use the full
//     HDR range — true HDR, with proper highlight roll-off to the display peak.
//     Both curves carry an explicit peak parameter built for this (GT7's
//     framebufferLuminanceTarget_, Uchimura's P).
//   * All OTHER modes (AgX, Reinhard, Custom, …) fall back to SDR-parity: the
//     display-referred FilmColor is presented at CUSTOM_HDR_PAPER_WHITE nits, so
//     HDR matches SDR.  (Those curves saturate to [0,1] and have no display-peak
//     parameter — making them exploit HDR needs a curve reformulation; see
//     Docs/Tonemappers_HDR_Parity.md.)
//
// Set CUSTOM_HDR_PARITY 0 to fall back to the engine ACES HDR ODT.
// Set CUSTOM_HDR_NATIVE 0 to force GT/GT7 to SDR-parity too.
#define CUSTOM_HDR_PARITY        1
#define CUSTOM_HDR_NATIVE        1
// SDR reference-white luminance for the parity mapping (nits).  100 matches UE's
// 1.0-linear = 100 cd/m^2 convention; 200 is a common brighter SDR paper white.
#define CUSTOM_HDR_PAPER_WHITE   100.0
// Highlight-expansion knee for SDR-domain tonemappers taken into HDR (AgX mode 1,
// Reinhard mode 2, Custom/Hable mode 4): display value above this knee rolls up
// to the display peak; below it stays at the SDR reference.  Lower = more
// aggressive HDR highlights; higher = more SDR-like.  Range ~0.6-0.9.
#define CUSTOM_HDR_EXPAND_KNEE   0.75

// ── Apex (mode 7) ─ AgX chroma handling + GT display-peak tonescale ──────────
// AgX's hue stability comes from its inset (pre-curve desaturation) + outset
// (post-curve re-saturation).  Apex keeps those (controllable via APEX_INSET)
// but drives a Uchimura GT curve to the display peak instead of AgX's fixed
// [0,1] sigmoid — so it is HDR-native like GT/GT7 while keeping the AgX look.
#define APEX_INSET            1.0   // 0 = none, 1 = full AgX inset (hue stability)
#define APEX_CONTRAST         1.0   // GT curve contrast a
#define APEX_LINEAR_START     0.22  // GT curve m
#define APEX_LINEAR_LENGTH    0.4   // GT curve l
#define APEX_TOE              1.33  // GT curve toe power c
#define APEX_TOE_OFFSET       0.0   // GT curve pedestal b
#define APEX_SAT              1.0   // final saturation (look control)

// ── Prism (mode 8) ─ ShaderShift original ────────────────────────────────────
// Hue-preserving: tone-maps LUMINANCE only (in Rec.2020) with a generalized
// Reinhard curve (contrast + mid-gray anchor + display peak), reconstructs RGB
// by ratio (chroma/hue exactly preserved), then applies the MINIMAL highlight
// desaturation needed to fit the display peak (path-to-white that preserves
// luminance & hue angle).  Vivid mids, clean roll-to-white, no per-channel hue
// skew; HDR-native by construction (curve targets the peak).
#define PRISM_CONTRAST        1.15  // luminance S-curve contrast
#define PRISM_MID_IN          0.18  // scene mid-gray
#define PRISM_MID_OUT         0.18  // display mid-gray (frame-buffer units; constant SDR/HDR)
#define PRISM_DESAT           1.0   // 1 = full fit-to-peak (no clip); <1 = allow vivid clipping


// Hue-preserving highlight correction.  When 1, the per-channel tonemap
// output is replaced (at high luminance) with a luminance-scaled version of
// the original HDR input — pre-4.17 Unreal behaviour where bright emissive
// cores keep their colour instead of trending to white through ACES/AgX.
// Wired to ShaderShift's "Preserve Emissive Color" checkbox.

#define CUSTOM_BLOOM_PRESERVE_COLOR 0

