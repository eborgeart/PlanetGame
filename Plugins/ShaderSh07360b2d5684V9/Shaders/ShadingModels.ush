// ===========================================================================
// ShaderShift live-tweak channel (editor look-dev) -- added by ShaderShift.
//
// Routes one parameter at a time through the View tweak lanes so it can be
// dragged in real time with NO shader recompile.  ShadingModels.ush always
// binds the View uniform buffer (it already samples View.SSProfiles* /
// View.PreIntegratedBRDF), so this read is valid in every BxDF pass --
// including the deferred-light pass, where the Scene UB is NOT bound.
//
//   round(View.GeneralPurposeTweak) == ParamId -> use View.GeneralPurposeTweak2
//   otherwise                                  -> baked compile-time default
// ===========================================================================
#ifndef SHADERSHIFT_LIVE_TWEAKS
#define SHADERSHIFT_LIVE_TWEAKS 1
#endif

// Live float resolver -- guarded so transitive inclusion can't redefine it.
#ifndef SHADERSHIFT_LIVE_FLOAT_DEFINED
#define SHADERSHIFT_LIVE_FLOAT_DEFINED
float ShaderShift_LiveFloat(float ParamId, float DefaultValue)
{
#if SHADERSHIFT_LIVE_TWEAKS
	return (round(View.GeneralPurposeTweak) == ParamId)
		? View.GeneralPurposeTweak2
		: DefaultValue;
#else
	return DefaultValue;
#endif
}
#endif // SHADERSHIFT_LIVE_FLOAT_DEFINED

// ShaderShift: push the live (armed) tweak values into BRDF.ush's per-thread
// globals before any BxDF runs.  Guarded against transitive double-definition
// (Substrate pulls in ShadingModels.ush).  SHADERSHIFT_LIVE_TWEAKS==0 (cooked)
// leaves the body empty so the globals keep their baked compile-time defaults.
// [generated] ShaderShift live-slot decode core (v3 banked) -- Build/gen_live_slots.py.  Do not hand-edit.
// Focus lane (GeneralPurposeTweak==id) = full-precision knob being dragged now;
// slot lanes = every dirty knob at 10-bit in the View *OverrideParameter floats
// (code 1023 = clean -> baked default).  Armed marker = sign bit of BOTH the
// Specular.x and Normal.x override params -- the only clamp-safe home:
// SetupCommonViewUniformBufferParameters rewrites Diffuse.yzw + Roughness.y
// pre-UB.  Mode-exclusive BRDF knobs share bank lanes (diffuse bank 0-16,
// spec bank 17-20); the control lane (21) carries which diffuse/spec mode owns
// each bank, so a non-owner knob reads its baked default, never a foreign code.
#ifndef SSL_ARMED
#if SHADERSHIFT_LIVE_TWEAKS
#define SSL_ARMED(SYM) ((asuint(SYM.SpecularOverrideParameter.x) & asuint(SYM.NormalOverrideParameter.x) & 0x80000000u) != 0u)
#define SSL_CODE(SYM, MEMBER, LN) ((asuint(SYM.MEMBER) >> ((LN) * 10u)) & 0x3FFu)
#define SSL_DEC(SYM, MEMBER, LN, LO, HI, DEF) ((SSL_ARMED(SYM) && SSL_CODE(SYM, MEMBER, LN) != 1023u) ? ((LO) + ((HI) - (LO)) * ((float)SSL_CODE(SYM, MEMBER, LN) * (1.0 / 1022.0))) : (DEF))
#define SSL_KNOB(SYM, ID, MEMBER, LN, LO, HI, DEF) ((round(SYM.GeneralPurposeTweak) == (ID)) ? SYM.GeneralPurposeTweak2 : SSL_DEC(SYM, MEMBER, LN, LO, HI, DEF))
#define SSL_CTRL(SYM) SSL_CODE(SYM, NormalOverrideParameter.w, 0u)
#define SSL_DOWNER(SYM) (SSL_CTRL(SYM) & 0xFu)
#define SSL_SOWNER(SYM) ((SSL_CTRL(SYM) >> 4u) & 0xFu)
#define SSL_DECB(SYM, MEMBER, LN, OWN, LO, HI, DEF) ((SSL_ARMED(SYM) && (OWN) && SSL_CODE(SYM, MEMBER, LN) != 1023u) ? ((LO) + ((HI) - (LO)) * ((float)SSL_CODE(SYM, MEMBER, LN) * (1.0 / 1022.0))) : (DEF))
#define SSL_KNOBB(SYM, ID, MEMBER, LN, OWN, LO, HI, DEF) ((round(SYM.GeneralPurposeTweak) == (ID)) ? SYM.GeneralPurposeTweak2 : SSL_DECB(SYM, MEMBER, LN, OWN, LO, HI, DEF))
#else
#define SSL_KNOB(SYM, ID, MEMBER, LN, LO, HI, DEF) (DEF)
#define SSL_KNOBB(SYM, ID, MEMBER, LN, OWN, LO, HI, DEF) (DEF)
#endif
#endif // SSL_ARMED
#ifndef SSL_KNOB_4
#define SSL_KNOB_4(DEF) SSL_KNOBB(View, 4.0, NormalOverrideParameter.y, 2u, SSL_SOWNER(View) == 1u, 0.0, 1.0, DEF) // CUSTOM_SPEC_PRIMARY_WEIGHT [ML bank lane 17]
#endif
#ifndef SSL_KNOB_5
#define SSL_KNOB_5(DEF) SSL_KNOBB(View, 5.0, NormalOverrideParameter.z, 0u, SSL_SOWNER(View) == 1u, 0.0, 2.0, DEF) // CUSTOM_SPEC_PRIMARY_ROUGHNESS_SCALE [ML bank lane 18]
#endif
#ifndef SSL_KNOB_6
#define SSL_KNOB_6(DEF) SSL_KNOBB(View, 6.0, NormalOverrideParameter.z, 1u, SSL_SOWNER(View) == 1u, 0.0, 4.0, DEF) // CUSTOM_SPEC_SECONDARY_ROUGHNESS_SCALE [ML bank lane 19]
#endif
#ifndef SSL_KNOB_7
#define SSL_KNOB_7(DEF) SSL_KNOBB(View, 7.0, NormalOverrideParameter.z, 2u, SSL_SOWNER(View) == 1u, 0.0, 1.0, DEF) // CUSTOM_SPEC_SECONDARY_MAX_ROUGHNESS [ML bank lane 20]
#endif
#ifndef SSL_KNOB_8
#define SSL_KNOB_8(DEF) SSL_KNOBB(View, 8.0, NormalOverrideParameter.y, 2u, SSL_SOWNER(View) == 2u, 0.0, 1.0, DEF) // CALLISTO_SPEC_FRESNEL_FALLOFF [CD bank lane 17]
#endif
#ifndef SSL_KNOB_9
#define SSL_KNOB_9(DEF) SSL_KNOBB(View, 9.0, NormalOverrideParameter.z, 0u, SSL_SOWNER(View) == 2u, 1.0, 14.0, DEF) // CALLISTO_DUAL_SPEC_ROUGHNESS_SCALE [CD bank lane 18]
#endif
#ifndef SSL_KNOB_10
#define SSL_KNOB_10(DEF) SSL_KNOBB(View, 10.0, NormalOverrideParameter.z, 1u, SSL_SOWNER(View) == 2u, 0.0, 1.0, DEF) // CALLISTO_DUAL_SPEC_OPACITY [CD bank lane 19]
#endif
#ifndef SSL_KNOB_11
#define SSL_KNOB_11(DEF) SSL_KNOBB(View, 11.0, SpecularOverrideParameter.x, 0u, SSL_DOWNER(View) == 5u, 0.0, 8.0, DEF) // CALLISTO_DIFF_FRESNEL [CA bank lane 0]
#endif
#ifndef SSL_KNOB_12
#define SSL_KNOB_12(DEF) SSL_KNOBB(View, 12.0, SpecularOverrideParameter.x, 1u, SSL_DOWNER(View) == 5u, 0.0, 1.0, DEF) // CALLISTO_DIFF_FRESNEL_FALLOFF [CA bank lane 1]
#endif
#ifndef SSL_KNOB_13
#define SSL_KNOB_13(DEF) SSL_KNOBB(View, 13.0, SpecularOverrideParameter.x, 2u, SSL_DOWNER(View) == 5u, 0.0, 1.0, DEF) // CALLISTO_DIFF_FRESNEL_TAN_FALLOFF [CA bank lane 2]
#endif
#ifndef SSL_KNOB_14
#define SSL_KNOB_14(DEF) SSL_KNOBB(View, 14.0, SpecularOverrideParameter.y, 0u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_DIFF_FRESNEL_TINT_R [CA bank lane 3]
#endif
#ifndef SSL_KNOB_15
#define SSL_KNOB_15(DEF) SSL_KNOBB(View, 15.0, SpecularOverrideParameter.y, 1u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_DIFF_FRESNEL_TINT_G [CA bank lane 4]
#endif
#ifndef SSL_KNOB_16
#define SSL_KNOB_16(DEF) SSL_KNOBB(View, 16.0, SpecularOverrideParameter.y, 2u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_DIFF_FRESNEL_TINT_B [CA bank lane 5]
#endif
#ifndef SSL_KNOB_17
#define SSL_KNOB_17(DEF) SSL_KNOBB(View, 17.0, SpecularOverrideParameter.z, 0u, SSL_DOWNER(View) == 5u, 0.0, 8.0, DEF) // CALLISTO_RETRO [CA bank lane 6]
#endif
#ifndef SSL_KNOB_18
#define SSL_KNOB_18(DEF) SSL_KNOBB(View, 18.0, SpecularOverrideParameter.z, 1u, SSL_DOWNER(View) == 5u, 0.0, 1.0, DEF) // CALLISTO_RETRO_FALLOFF [CA bank lane 7]
#endif
#ifndef SSL_KNOB_19
#define SSL_KNOB_19(DEF) SSL_KNOBB(View, 19.0, SpecularOverrideParameter.z, 2u, SSL_DOWNER(View) == 5u, 0.0, 1.0, DEF) // CALLISTO_RETRO_TAN_FALLOFF [CA bank lane 8]
#endif
#ifndef SSL_KNOB_20
#define SSL_KNOB_20(DEF) SSL_KNOBB(View, 20.0, SpecularOverrideParameter.w, 0u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_RETRO_TINT_R [CA bank lane 9]
#endif
#ifndef SSL_KNOB_21
#define SSL_KNOB_21(DEF) SSL_KNOBB(View, 21.0, SpecularOverrideParameter.w, 1u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_RETRO_TINT_G [CA bank lane 10]
#endif
#ifndef SSL_KNOB_22
#define SSL_KNOB_22(DEF) SSL_KNOBB(View, 22.0, SpecularOverrideParameter.w, 2u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_RETRO_TINT_B [CA bank lane 11]
#endif
#ifndef SSL_KNOB_23
#define SSL_KNOB_23(DEF) SSL_KNOBB(View, 23.0, NormalOverrideParameter.x, 0u, SSL_DOWNER(View) == 5u, -1.0, 1.0, DEF) // CALLISTO_SMOOTH_TERM [CA bank lane 12]
#endif
#ifndef SSL_KNOB_24
#define SSL_KNOB_24(DEF) SSL_KNOBB(View, 24.0, NormalOverrideParameter.x, 1u, SSL_DOWNER(View) == 5u, 0.0, 1.0, DEF) // CALLISTO_SMOOTH_TERM_LENGTH [CA bank lane 13]
#endif
#ifndef SSL_KNOB_25
#define SSL_KNOB_25(DEF) SSL_KNOBB(View, 25.0, NormalOverrideParameter.x, 2u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_SMOOTH_TERM_TINT_R [CA bank lane 14]
#endif
#ifndef SSL_KNOB_26
#define SSL_KNOB_26(DEF) SSL_KNOBB(View, 26.0, NormalOverrideParameter.y, 0u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_SMOOTH_TERM_TINT_G [CA bank lane 15]
#endif
#ifndef SSL_KNOB_27
#define SSL_KNOB_27(DEF) SSL_KNOBB(View, 27.0, NormalOverrideParameter.y, 1u, SSL_DOWNER(View) == 5u, 0.0, 2.0, DEF) // CALLISTO_SMOOTH_TERM_TINT_B [CA bank lane 16]
#endif
#ifndef SSL_KNOB_28
#define SSL_KNOB_28(DEF) SSL_KNOBB(View, 28.0, SpecularOverrideParameter.x, 0u, SSL_DOWNER(View) == 6u, 0.0, 4.0, DEF) // CALLISTO_PROXIMA_ALPHA_SCALE [PX bank lane 0]
#endif
#ifndef SSL_KNOB_44
#define SSL_KNOB_44(DEF) ((SHADERSHIFT_LIVE_TWEAKS != 0 && round(View.GeneralPurposeTweak) == 44.0) ? View.GeneralPurposeTweak2 : (SSL_ARMED(View) && SSL_SOWNER(View) == 3u && SSL_CODE(View, NormalOverrideParameter.z, 0u) != 1023u) ? (0.0 + (1.0 - 0.0) * ((float)SSL_CODE(View, NormalOverrideParameter.z, 0u) * (1.0 / 1022.0))) : SSL_DECB(View, SpecularOverrideParameter.x, 1u, SSL_DOWNER(View) == 7u, 0.0, 1.0, DEF)) // REGOLITH_COVERAGE [spec bank lane 18 / diffuse bank lane 1 -- dual-axis Regolith]
#endif
#ifndef SSL_KNOB_45
#define SSL_KNOB_45(DEF) ((SHADERSHIFT_LIVE_TWEAKS != 0 && round(View.GeneralPurposeTweak) == 45.0) ? View.GeneralPurposeTweak2 : (SSL_ARMED(View) && SSL_SOWNER(View) == 3u && SSL_CODE(View, NormalOverrideParameter.z, 1u) != 1023u) ? (0.05 + (1.0 - 0.05) * ((float)SSL_CODE(View, NormalOverrideParameter.z, 1u) * (1.0 / 1022.0))) : SSL_DECB(View, SpecularOverrideParameter.x, 2u, SSL_DOWNER(View) == 7u, 0.05, 1.0, DEF)) // REGOLITH_GRAIN_ROUGHNESS [spec bank lane 19 / diffuse bank lane 2 -- dual-axis Regolith]
#endif
#ifndef SSL_KNOB_46
#define SSL_KNOB_46(DEF) SSL_KNOBB(View, 46.0, SpecularOverrideParameter.x, 0u, SSL_DOWNER(View) == 7u, 0.0, 2.0, DEF) // REGOLITH_RETRO [RD bank lane 0]
#endif
#ifndef SSL_KNOB_47
#define SSL_KNOB_47(DEF) SSL_KNOBB(View, 47.0, NormalOverrideParameter.y, 2u, SSL_SOWNER(View) == 3u, 0.0, 2.0, DEF) // REGOLITH_SHEEN [RS bank lane 17]
#endif
#ifndef SSL_KNOB_48
#define SSL_KNOB_48(DEF) ((SHADERSHIFT_LIVE_TWEAKS != 0 && round(View.GeneralPurposeTweak) == 48.0) ? View.GeneralPurposeTweak2 : (SSL_ARMED(View) && SSL_SOWNER(View) == 3u && SSL_CODE(View, NormalOverrideParameter.z, 2u) != 1023u) ? (0.0 + (1.0 - 0.0) * ((float)SSL_CODE(View, NormalOverrideParameter.z, 2u) * (1.0 / 1022.0))) : SSL_DECB(View, SpecularOverrideParameter.y, 0u, SSL_DOWNER(View) == 7u, 0.0, 1.0, DEF)) // REGOLITH_ROUGHNESS_AFFINITY [spec bank lane 20 / diffuse bank lane 3 -- dual-axis Regolith]
#endif

#ifndef SHADERSHIFT_LIVE_BRDF_GLOBALS_DEFINED
#define SHADERSHIFT_LIVE_BRDF_GLOBALS_DEFINED
void ShaderShift_SetLiveBRDFGlobals()
{
#if SHADERSHIFT_LIVE_TWEAKS
	// [generated] every BRDF tunable resolves focus-lane -> slot-lane -> baked.
	gSSL_CUSTOM_SPEC_PRIMARY_WEIGHT = SSL_KNOB_4(CUSTOM_SPEC_PRIMARY_WEIGHT);
	gSSL_CUSTOM_SPEC_PRIMARY_ROUGHNESS_SCALE = SSL_KNOB_5(CUSTOM_SPEC_PRIMARY_ROUGHNESS_SCALE);
	gSSL_CUSTOM_SPEC_SECONDARY_ROUGHNESS_SCALE = SSL_KNOB_6(CUSTOM_SPEC_SECONDARY_ROUGHNESS_SCALE);
	gSSL_CUSTOM_SPEC_SECONDARY_MAX_ROUGHNESS = SSL_KNOB_7(CUSTOM_SPEC_SECONDARY_MAX_ROUGHNESS);
	gSSL_CALLISTO_SPEC_FRESNEL_FALLOFF = SSL_KNOB_8(CALLISTO_SPEC_FRESNEL_FALLOFF);
	gSSL_CALLISTO_DUAL_SPEC_ROUGHNESS_SCALE = SSL_KNOB_9(CALLISTO_DUAL_SPEC_ROUGHNESS_SCALE);
	gSSL_CALLISTO_DUAL_SPEC_OPACITY = SSL_KNOB_10(CALLISTO_DUAL_SPEC_OPACITY);
	gSSL_CALLISTO_DIFF_FRESNEL = SSL_KNOB_11(CALLISTO_DIFF_FRESNEL);
	gSSL_CALLISTO_DIFF_FRESNEL_FALLOFF = SSL_KNOB_12(CALLISTO_DIFF_FRESNEL_FALLOFF);
	gSSL_CALLISTO_DIFF_FRESNEL_TAN_FALLOFF = SSL_KNOB_13(CALLISTO_DIFF_FRESNEL_TAN_FALLOFF);
	gSSL_CALLISTO_DIFF_FRESNEL_TINT_R = SSL_KNOB_14(CALLISTO_DIFF_FRESNEL_TINT_R);
	gSSL_CALLISTO_DIFF_FRESNEL_TINT_G = SSL_KNOB_15(CALLISTO_DIFF_FRESNEL_TINT_G);
	gSSL_CALLISTO_DIFF_FRESNEL_TINT_B = SSL_KNOB_16(CALLISTO_DIFF_FRESNEL_TINT_B);
	gSSL_CALLISTO_RETRO = SSL_KNOB_17(CALLISTO_RETRO);
	gSSL_CALLISTO_RETRO_FALLOFF = SSL_KNOB_18(CALLISTO_RETRO_FALLOFF);
	gSSL_CALLISTO_RETRO_TAN_FALLOFF = SSL_KNOB_19(CALLISTO_RETRO_TAN_FALLOFF);
	gSSL_CALLISTO_RETRO_TINT_R = SSL_KNOB_20(CALLISTO_RETRO_TINT_R);
	gSSL_CALLISTO_RETRO_TINT_G = SSL_KNOB_21(CALLISTO_RETRO_TINT_G);
	gSSL_CALLISTO_RETRO_TINT_B = SSL_KNOB_22(CALLISTO_RETRO_TINT_B);
	gSSL_CALLISTO_SMOOTH_TERM = SSL_KNOB_23(CALLISTO_SMOOTH_TERM);
	gSSL_CALLISTO_SMOOTH_TERM_LENGTH = SSL_KNOB_24(CALLISTO_SMOOTH_TERM_LENGTH);
	gSSL_CALLISTO_SMOOTH_TERM_TINT_R = SSL_KNOB_25(CALLISTO_SMOOTH_TERM_TINT_R);
	gSSL_CALLISTO_SMOOTH_TERM_TINT_G = SSL_KNOB_26(CALLISTO_SMOOTH_TERM_TINT_G);
	gSSL_CALLISTO_SMOOTH_TERM_TINT_B = SSL_KNOB_27(CALLISTO_SMOOTH_TERM_TINT_B);
	gSSL_CALLISTO_PROXIMA_ALPHA_SCALE = SSL_KNOB_28(CALLISTO_PROXIMA_ALPHA_SCALE);
	gSSL_REGOLITH_COVERAGE = SSL_KNOB_44(REGOLITH_COVERAGE);
	gSSL_REGOLITH_GRAIN_ROUGHNESS = SSL_KNOB_45(REGOLITH_GRAIN_ROUGHNESS);
	gSSL_REGOLITH_RETRO = SSL_KNOB_46(REGOLITH_RETRO);
	gSSL_REGOLITH_SHEEN = SSL_KNOB_47(REGOLITH_SHEEN);
	gSSL_REGOLITH_ROUGHNESS_AFFINITY = SSL_KNOB_48(REGOLITH_ROUGHNESS_AFFINITY);
#endif
}
#endif // SHADERSHIFT_LIVE_BRDF_GLOBALS_DEFINED



