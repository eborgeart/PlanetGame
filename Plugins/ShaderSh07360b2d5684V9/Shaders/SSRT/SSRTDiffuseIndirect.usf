// Copyright Epic Games, Inc. All Rights Reserved.
// SHADERSHIFT MODIFIED -- adds Screen Space Indirect Lighting with Visibility
// Bitmask (SSILVB) as a drop-in replacement for the engine's SSGI ray-cast
// path.  Gated by CUSTOM_SSGI_MODE; when 0 this file compiles to byte-
// equivalent output of the stock UE 5.7 shader.  See the "ShaderShift SSGI
// Modes" block below for the algorithm and the dispatch site inside MainCS.
//
// NOTE: only the DIFFUSE_TERM path of this shader supports SSILVB GI.  The
// SPECULAR_TERM path (Lumen-disabled SSR) is left untouched -- SSILVB is
// a diffuse irradiance technique.
//
// This shader runs only when r.SSGI.Enable=1 AND Lumen GI is disabled
// (r.DynamicGlobalIlluminationMethod=0 or 2).  With Lumen GI enabled the
// engine takes a different code path; the SSILVB hook here has no effect.

// SHADERSHIFT: SSGI method selector.  Replaced at apply-time by the plugin's
// BuildFinalSource() with the user's ECustomSSGIMode value.
//   0 = Engine Default (stochastic SSRT ray cast, unchanged)
//   1 = SSILVB (Visibility-Bitmask Indirect Diffuse + AO)
//   2 = Diagnostic (magenta tint -- verify the hook reaches the GPU)
//   3 = Stable SSGI (engine ray cast with frame-stable sample directions
//                    and step offsets -- TSR/TAA can lock onto the result
//                    instead of rejecting the per-frame Hammersley shuffle)
#define CUSTOM_SSGI_MODE 0

// SHADERSHIFT: per-lane supersampling multiplier for Stable SSGI (Mode 3)
// AND SSILVB (Mode 1).  Replaced at apply-time by the plugin's
// BuildFinalSource() with the user's ECustomSSGIQuality value.
//   Mode 3: each lane casts MULTIPLIER Hammersley rays instead of one.
//   Mode 1: each lane traces MULTIPLIER hemisphere slices drawn from a fan
//           of CONFIG_RAY_COUNT * MULTIPLIER azimuths.
// Each lane writes the mean to LDS so the tile-local bilateral denoiser
// keeps working unchanged.  Default 1 = no supersample.
//   1 = x1 (baseline)
//   2 = x2 (~sqrt(2) less noise)
//   4 = x4 (half the noise)
//   8 = x8 (smoothest, linear cost)
#define CUSTOM_SSGI_RAY_MULTIPLIER 1

// SHADERSHIFT: SSILVB indirect-diffuse tunables (consumed only when
// CUSTOM_SSGI_MODE == 1).  These are plain compile-time #defines -- edit the
// values here, or wire them to UShaderShiftSettings float properties via the
// CUSTOM_* float-tunable table in ShaderShift.cpp (the same mechanism that
// drives CUSTOM_TAA_CLAMP_FACTOR etc.).  BuildFinalSource() rewrites only the
// value token and preserves the trailing comment, so the "#define NAME value"
// shape must be kept intact.  All distances are in world units (UE = cm).
//
//   RADIUS      : the SSILVB gather extent ("r" in the paper), expressed as a
//                 world distance at the receiver depth; it sets how far the
//                 slice marches across the screen (projected to pixels).  For
//                 room/box-scale GI this MUST be large enough to reach the
//                 surrounding walls -- too small and a pixel only samples its
//                 own coplanar surface and gathers almost nothing (this was the
//                 root cause of the near-black interior: at 300 only ~5% of the
//                 hemisphere registered).  There is intentionally NO hard
//                 world-distance cull (the paper attenuates via the thickness
//                 model, not a falloff), so RADIUS bounds the on-screen march,
//                 not which hits are allowed to contribute.
#define CUSTOM_SSGI_RADIUS 700.0
//   THICKNESS   : constant assumed world-space thickness of each depth sample
//                 ("t" in the paper / "hitThickness"), in cm.  This is the core
//                 SSILVB knob and is what attenuates contribution over distance
//                 (replacing a falloff): a sample occludes a wedge t deep behind
//                 its front face, letting light pass *behind* thinner surfaces.
//                 It is a real-object scale (tens of cm), independent of the
//                 screen-march RADIUS.  Smaller -> brighter / more leak; larger
//                 -> darker / GTAO-like over-occlusion.
#define CUSTOM_SSGI_THICKNESS 40.0
//   INTENSITY   : main brightness knob on the gathered indirect diffuse.
//                 The slice estimator is normalised in TraceSlice by pi/2 so
//                 that a uniform-radiance surround integrates to the same
//                 value the engine's stock cosine-sampled SSGI reports --
//                 INTENSITY 1.0 == engine-parity brightness.  SSILVB still
//                 reads a touch dimmer than stock on real scenes because it
//                 weights every emitter by its foreshortening cosine
//                 (n_j.-l), which stock SSGI ignores; default 2.0 compensates
//                 tastefully.  Tune ~1-4.  Very high values risk an
//                 over-bright multi-bounce feedback loop via the prev-frame
//                 colour buffer this pass samples.
#define CUSTOM_SSGI_INTENSITY 2.0
//   THICKNESS_DISTANCE : optional linear growth of thickness with view depth
//                 (paper 3.1) to counter far-field over-thinness.  Effective
//                 thickness = THICKNESS * (1 + depth_metres * THICKNESS_DISTANCE).
//                 0 = constant world thickness (default).
#define CUSTOM_SSGI_THICKNESS_DISTANCE 0.0
//   MAX_SCREEN_FRACTION : upper clamp on the on-screen march, as a fraction of
//                 viewport height (resolution independent).  Bounds per-sample
//                 bandwidth when RADIUS projects very large up close.  ~0.6 lets
//                 a pixel reach most of the visible room; lower trades reach for
//                 performance.  (Replaces the old absolute-pixel clamp, which at
//                 192 px also starved the gather on higher-res viewports.)
#define CUSTOM_SSGI_MAX_SCREEN_FRACTION 0.6
//   AO_STRENGTH : how much occlusion this GI pass contributes.  UE feeds this
//                 pass's AO output into the diffuse-indirect composite, where it
//                 attenuates skylight/ambient.  SSILVB reports heavy occlusion
//                 inside concave geometry (e.g. a room/box), so driving AO at
//                 full strength here crushes the ambient fill to black -- which
//                 reads as a dark interior even though the GI gather is working.
//                 0 = this pass emits neutral AO (=1) and contributes GI colour
//                 only (let the dedicated SSILVB AO pass own occlusion); 1 =
//                 full SSILVB directional AO from this pass as well.
#define CUSTOM_SSGI_AO_STRENGTH 0.0

// === ShaderShift live-tweak macro (editor look-dev; see ShaderShiftRuntimeParams.h) ===
// Expands inline at the use site (View is bound there).  Packaged builds set
// SHADERSHIFT_LIVE_TWEAKS 0, collapsing it to the bare compile-time default.
#ifndef SHADERSHIFT_LIVE_TWEAKS
#define SHADERSHIFT_LIVE_TWEAKS 1
#endif
// [generated] ShaderShift live-slot decode core (v3 banked) -- Build/gen_live_slots.py.  Do not hand-edit.
// Focus lane (GeneralPurposeTweak==id) = full-precision knob being dragged now;
// slot lanes = every dirty knob at 10-bit in the View *OverrideParameter floats
// (code 1023 = clean -> baked default).  Armed marker = sign bit of BOTH the
// Specular.x and Normal.x override params -- the only clamp-safe home:
// SetupCommonViewUniformBufferParameters rewrites Diffuse.yzw + Roughness.y
// pre-UB.  Mode-exclusive BRDF knobs share bank lanes (diffuse bank 0-16,
// spec bank 17-20); the control lane (21) carries which diffuse/spec mode owns
// each bank, so a non-owner knob reads its baked default, never a foreign code.
#ifndef SSL_ARMED
#if SHADERSHIFT_LIVE_TWEAKS
#define SSL_ARMED(SYM) ((asuint(SYM.SpecularOverrideParameter.x) & asuint(SYM.NormalOverrideParameter.x) & 0x80000000u) != 0u)
#define SSL_CODE(SYM, MEMBER, LN) ((asuint(SYM.MEMBER) >> ((LN) * 10u)) & 0x3FFu)
#define SSL_DEC(SYM, MEMBER, LN, LO, HI, DEF) ((SSL_ARMED(SYM) && SSL_CODE(SYM, MEMBER, LN) != 1023u) ? ((LO) + ((HI) - (LO)) * ((float)SSL_CODE(SYM, MEMBER, LN) * (1.0 / 1022.0))) : (DEF))
#define SSL_KNOB(SYM, ID, MEMBER, LN, LO, HI, DEF) ((round(SYM.GeneralPurposeTweak) == (ID)) ? SYM.GeneralPurposeTweak2 : SSL_DEC(SYM, MEMBER, LN, LO, HI, DEF))
#define SSL_CTRL(SYM) SSL_CODE(SYM, NormalOverrideParameter.w, 0u)
#define SSL_DOWNER(SYM) (SSL_CTRL(SYM) & 0xFu)
#define SSL_SOWNER(SYM) ((SSL_CTRL(SYM) >> 4u) & 0xFu)
#define SSL_DECB(SYM, MEMBER, LN, OWN, LO, HI, DEF) ((SSL_ARMED(SYM) && (OWN) && SSL_CODE(SYM, MEMBER, LN) != 1023u) ? ((LO) + ((HI) - (LO)) * ((float)SSL_CODE(SYM, MEMBER, LN) * (1.0 / 1022.0))) : (DEF))
#define SSL_KNOBB(SYM, ID, MEMBER, LN, OWN, LO, HI, DEF) ((round(SYM.GeneralPurposeTweak) == (ID)) ? SYM.GeneralPurposeTweak2 : SSL_DECB(SYM, MEMBER, LN, OWN, LO, HI, DEF))
#else
#define SSL_KNOB(SYM, ID, MEMBER, LN, LO, HI, DEF) (DEF)
#define SSL_KNOBB(SYM, ID, MEMBER, LN, OWN, LO, HI, DEF) (DEF)
#endif
#endif // SSL_ARMED
#ifndef SSL_KNOB_30
#define SSL_KNOB_30(DEF) SSL_KNOB(View, 30.0, AmbientOcclusionOverrideParameter.x, 0u, 0.0, 20.0, DEF) // CUSTOM_SSGI_INTENSITY [lane 30]
#endif

// Generate vector truncation warnings to errors.
#pragma warning(error: 3206)

